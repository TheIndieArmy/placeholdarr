# Development Dockerfile - code is mounted as volume instead of copied
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Copy only requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Install development tools for faster debugging
RUN pip install --no-cache-dir ipdb watchdog

# Expose application port
EXPOSE 8000

# Start the FastAPI app with Uvicorn and auto-reload for development
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
