# Server Configuration
PLACEHOLDARR_HOST=0.0.0.0
PLACEHOLDARR_PORT=8000
PLACEHOLDARR_LOG_LEVEL=INFO # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Onboarding-managed settings
# The settings below can be configured in the dashboard onboarding wizard.
# Keep them omitted here by default for a clean first-run onboarding flow.

# Migration from Infinite To Placeholdarr
MIGRATION=False # Set to True to enable Migration

# Startup sync behavior is onboarding-managed.

# Cron schedule for Radarr (standard) movie sync (blank disables scheduling)
RADARR_SYNC_CRON=""
# Cron schedule for Radarr (4K) movie sync (blank disables scheduling)
RADARR_4K_SYNC_CRON=""

# Cron schedule for Sonarr (standard) series sync (blank disables scheduling)
SONARR_SYNC_CRON=""
# Cron schedule for Sonarr (4K) series sync (blank disables scheduling)
SONARR_4K_SYNC_CRON=""

# Optional instance-key overrides used for:
# - webhook query parameter validation (instance=...)
# - source labeling on events/jobs
# - content row instance_key persistence in DB
RADARR_STD_INSTANCE_KEY=radarr_std
RADARR_4K_INSTANCE_KEY=radarr_4k
SONARR_STD_INSTANCE_KEY=sonarr_std
SONARR_4K_INSTANCE_KEY=sonarr_4k
TAUTULLI_INSTANCE_KEY=tautulli
JELLYFIN_INSTANCE_KEY=jellyfin
EMBY_INSTANCE_KEY=emby

# General app behavior (paths, integrations, playback, calendar, placeholder behavior)
# is onboarding-managed and intentionally omitted from this env file.
# Force a one-time prime pass on startup.
# Leave false for normal operation; set true only for rare Plex recovery/unlock cases.
FORCE_PRIME_ON_STARTUP=false

# --- Advanced Webhook Check Options ---
# Set to 'true' to skip all webhook checks and force calendar sync to start (not recommended for most users)
PLACEHOLDARR_SKIP_WEBHOOK_CHECK=false


# --- Database Configuration ---
# Database host (e.g., localhost, 127.0.0.1, or your DB server address)
DB_HOST=localhost
# Database port (default for Postgres is 5432)
DB_PORT=5432
# Database username (set in your Postgres container or server)
DB_USER=your_db_user
# Database password (set in your Postgres container or server)
DB_PASS=your_db_password
# Database name (set in your Postgres container or server)
DB_NAME=your_db_name

# Optionally override the webhook URL used for *arr webhook checks (useful for reverse proxies, custom domains, or remote networks)
# Example: PLACEHOLDARR_WEBHOOK_URL=https://my.public.domain/webhook
# Leave blank to use automatic detection
PLACEHOLDARR_WEBHOOK_URL=

