# Optional Placeholdarr environment overrides
#
# Docker default behavior (no .env required):
# - Appdata mount defaults to ./.appdata on host
# - App container uses bundled Postgres service from docker-compose.yml
# - General app behavior is configured in onboarding/settings UI

# Optional server overrides
PLACEHOLDARR_HOST=0.0.0.0
# Container / process listen port (default 8000). In Docker, set this in compose
# environment and make the right side of ports: match (e.g. "9000:9000").
# Host-only remaps (e.g. "9000:8000") leave this at 8000.
PLACEHOLDARR_PORT=8000

# Optional startup behavior overrides
PLACEHOLDARR_SKIP_WEBHOOK_CHECK=false

# Optional playback webhook source instance key overrides
# Most users should leave these defaults unchanged.
TAUTULLI_INSTANCE_KEY=tautulli
JELLYFIN_INSTANCE_KEY=jellyfin
EMBY_INSTANCE_KEY=emby

# Optional override for the URL ARR/Tautulli/Jellyfin/Emby should use to
# call Placeholdarr — only the URL displayed in webhook setup instructions.
# Use this when those services reach Placeholdarr at a different address
# than the URL you use to view the dashboard (for example, an internal
# Docker/Kubernetes service name when the dashboard is reached through a
# public reverse proxy). No trailing slash.
# Can also be set in Settings → Advanced → "Webhook base URL".
# WEBHOOK_BASE_URL=http://placeholdarr:8000

# Optional Postgres connection overrides
# Bundled compose already sets these on the placeholdarr service. Override here
# or in docker-compose environment: when using an external Postgres, or when you
# want different credentials than the compose defaults.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=placeholdarr
# DB_NAME=placeholdarr
# Password: set either a literal or a file path (same vars work in compose
# environment:). Non-empty DB_PASS wins over DB_PASS_FILE.
# DB_PASS=change_me_db_password
# DB_PASS_FILE=/run/secrets/placeholdarr_db_pass
# With the bundled Postgres service, pair DB_PASS_FILE with
# POSTGRES_PASSWORD_FILE on placeholdarr_postgres (same secret contents).

# Catalog mode (also in Settings → Library sync). Default is Arr catalog.
# TMDB Discover uses the same database (tmdb_movie / arr_movie_overlay tables);
# a separate DB is optional for isolated testing, not required for beta.
# CATALOG_MODE=arr_catalog
# CATALOG_MODE=tmdb_discover

# Optional host appdata override used by docker-compose volume mappings.
# Uncomment and edit if you do not want to use the default ./.appdata path.
# PLACEHOLDARR_APPDATA=./.appdata